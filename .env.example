# ---------- Telegram ----------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Single chat id or comma-separated list — the bot fans out to every id.
# Use your numeric user id (talk to @userinfobot) or a channel id (-100…).
TELEGRAM_CHAT_ID=123456789

# ---------- Search filters ----------
OPERATION_TYPE=alquiler           # alquiler | venta
PROPERTY_TYPES=departamentos      # comma-separated: departamentos,ph,casas
NEIGHBORHOODS=palermo,belgrano    # comma-separated list of slugs (lowercase)
PRICE_MIN=300000
PRICE_MAX=800000
CURRENCY=ARS                      # ARS | USD
ROOMS_MIN=2
ROOMS_MAX=3
AREA_MIN=45

# ---------- Scheduler ----------
CHECK_INTERVAL_MINUTES=15
# Alert on Telegram if no successful check happens for this many minutes.
# Set WATCHDOG_TIMEOUT_MINUTES=0 to disable.
WATCHDOG_TIMEOUT_MINUTES=30

# ---------- Security ----------
# Bearer token required for POST /api/check and PUT /api/filters.
API_KEY=change_me_to_a_long_random_string

# ---------- Scraper ----------
# Try httpx + BeautifulSoup4 first; flip to true if ZonaProp blocks plain
# requests on your IP and you want the Playwright (headless Chromium) fallback.
USE_PLAYWRIGHT=false
REQUEST_TIMEOUT=30

# ---------- Storage / app ----------
DATABASE_URL=sqlite+aiosqlite:///./data/zonaprop.db
LOG_LEVEL=INFO
