# ---------- Telegram ----------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Single chat id or comma-separated list — the bot fans out to every id.
# Use your numeric user id (talk to @userinfobot) or a channel id (-100…).
TELEGRAM_CHAT_ID=123456789

# ---------- Search filters ----------
# Real-world default: daily digest of new 2-ambiente apartment sales in
# the northern half of Buenos Aires (Retiro → Núñez corridor) under
# USD 95 000, at least 37 m², posted in the last 24h.
OPERATION_TYPE=venta              # alquiler | venta
PROPERTY_TYPES=departamentos      # comma-separated: departamentos,ph,casas
# Either a single city/region slug (capital-federal, gran-buenos-aires, …)
# or a comma-separated list of barrios (palermo,belgrano,recoleta, …).
# NB: ZonaProp 301-strips the LAST neighborhood from the path whenever a
# price slug is present, so the URL builder always omits the price slug
# when any neighborhood is configured and enforces the price band locally
# (see app/scheduler.py::_passes_filters). This is currency-aware: a
# listing whose currency differs from ``CURRENCY`` is dropped outright.
NEIGHBORHOODS=retiro,recoleta,palermo,belgrano,chacarita,villa-crespo,colegiales,coghlan,nunez
PRICE_MIN=0
PRICE_MAX=95000
CURRENCY=USD                      # ARS | USD
# 0 = no bound. Set rooms/area only if you want to narrow further.
ROOMS_MIN=2
ROOMS_MAX=2
AREA_MIN=37
# Only consider listings published within the last N days. 0 disables the
# recency filter (= all active listings).
PUBLISHED_WITHIN_DAYS=1

# ---------- Scheduler ----------
# Default: run once per day at 07:00 local time in Buenos Aires.
# Set DAILY_CHECK_TIME="" to fall back to the interval-based schedule below.
DAILY_CHECK_TIME=07:00
SCHEDULE_TIMEZONE=America/Argentina/Buenos_Aires
# Only used when DAILY_CHECK_TIME is empty.
CHECK_INTERVAL_MINUTES=15
# Alert on Telegram if no successful check happens for this many minutes.
# Set WATCHDOG_TIMEOUT_MINUTES=0 to disable.
WATCHDOG_TIMEOUT_MINUTES=30

# ---------- Security ----------
# Bearer token required for POST /api/check and PUT /api/filters.
API_KEY=change_me_to_a_long_random_string

# ---------- Scraper ----------
# Try httpx + BeautifulSoup4 first; flip to true if ZonaProp blocks plain
# requests on your IP and you want the Playwright (headless Chromium) fallback.
USE_PLAYWRIGHT=false
REQUEST_TIMEOUT=30

# ---------- Storage / app ----------
DATABASE_URL=sqlite+aiosqlite:///./data/zonaprop.db
LOG_LEVEL=INFO
